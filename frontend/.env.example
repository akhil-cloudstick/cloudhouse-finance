# Dev-only: where `next dev`'s /api/v1 and /uploads rewrites proxy to (see
# next.config.ts). Not read by the browser bundle. Defaults to
# http://localhost:8080 if unset, which is correct for the normal
# single-port dev workflow (`npm run dev` proxies to the Go backend on
# :8080) — only set this if your backend runs somewhere else.
BACKEND_ORIGIN=

# Client-facing API base URL (see lib/api.ts). Leave unset for the normal
# single-port dev/production setup, where the browser only ever talks to
# "/api/v1" on its own origin (the Go binary serves both the API and this
# built frontend). Only set this if the frontend and backend are ever
# served from genuinely different origins.
NEXT_PUBLIC_API_BASE=

# The tenant app's own origin — used by the super admin console
# (frontend/superadmin/services/tenantLink.ts) to build the sign-in link an
# operator copies for a business. Now that product/ and superadmin/ are
# built and served together, this is normally just this same dev server's
# own origin — defaults to http://localhost:3000 (the frontend's `next dev`
# default port; see package.json's dev script) if unset.
NEXT_PUBLIC_TENANT_APP_ORIGIN=

# ---- UI feature switches (product/config/features.ts) ----------------------
# Values are baked in at build time (output: "export"): rebuild, or restart
# `next dev`, after changing any of these.

# "true" shows the plan ladder and Upgrade flow on Billing. The upgrade is
# UI-only for now (simulated, no backend call). Anything else keeps the
# Billing page as it was.
NEXT_PUBLIC_ENABLE_PLAN_UPGRADE=false

# "true" shows the "Update available" card at the bottom of the sidebar.
NEXT_PUBLIC_ENABLE_UPDATE_NOTICE=false
# One line shown in that card. Changing it counts as a new update, so the
# card reappears for users who dismissed or finished the previous one.
NEXT_PUBLIC_UPDATE_NOTES=

# The plan ladder, in tier order, as one line of JSON. branches 0 = unlimited;
# price is the one-time amount in rupees (plans are not monthly). Leave empty
# (or invalid) to use the three defaults matching the backend's seeded tiers:
# NEXT_PUBLIC_BILLING_PLANS='[{"id":"single","name":"Single Branch","branches":1,"price":25000,"features":["1 branch"]},{"id":"five","name":"Up to 5 Branches","branches":5,"price":75000,"features":["Up to 5 branches"]},{"id":"unlimited","name":"Unlimited","branches":0,"price":150000,"features":["No branch limit"]}]'
NEXT_PUBLIC_BILLING_PLANS=
