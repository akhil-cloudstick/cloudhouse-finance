# Dev-only: where `next dev`'s /api/v1 and /uploads rewrites proxy to (see
# next.config.ts). Not read by the browser bundle. Defaults to
# http://localhost:8080 if unset, which is correct for the normal
# single-port dev workflow (`npm run dev` proxies to the Go backend on
# :8080) — only set this if your backend runs somewhere else.
BACKEND_ORIGIN=

# Client-facing API base URL (see lib/api.ts). Leave unset for the normal
# single-port dev/production setup, where the browser only ever talks to
# "/api/v1" on its own origin (the Go binary serves both the API and this
# built frontend). Only set this if the frontend and backend are ever
# served from genuinely different origins.
NEXT_PUBLIC_API_BASE=

# The tenant app's own origin — used by the super admin console
# (frontend/superadmin/services/tenantLink.ts) to build the sign-in link an
# operator copies for a business. Now that product/ and superadmin/ are
# built and served together, this is normally just this same dev server's
# own origin — defaults to http://localhost:3000 (the frontend's `next dev`
# default port; see package.json's dev script) if unset.
NEXT_PUBLIC_TENANT_APP_ORIGIN=
