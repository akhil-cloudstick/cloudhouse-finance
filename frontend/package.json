{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,openwa -c blue,green \"next dev -p 3000\" \"npm run dev:embedded --prefix ../OpenWA\"",
    "build": "next build",
    "start": "node scripts/start-desktop.cjs",
    "start:web": "next start",
    "dist": "npm run dist:win",
    "dist:win": "node scripts/package-win.cjs",
    "dist:content": "node scripts/package-content.cjs",
    "release": "npm run release:win",
    "release:win": "npm run dist:win && npm run upload && npm run download && npm run prune",
    "release:content": "cross-env RELEASE_BUILD_TYPE=content npm run dist:content && cross-env RELEASE_BUILD_TYPE=content npm run upload && cross-env RELEASE_BUILD_TYPE=content npm run download",
    "upload": "node scripts/upload.js",
    "download": "node scripts/download.js",
    "prune": "node scripts/prune.js",
    "tag": "node scripts/tag.cjs",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5"
  }
}
