{
  "expo": {
    "name": "CloudHouse Staff",
    "slug": "cloudhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cloudhouse.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cloudhouse.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/cloudhouse-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "cloudhouse",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/cloudhouse.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "transparent",
          "translucent": true
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "CloudHouse Gold Finance needs access to your photos to attach customer KYC documents.",
          "cameraPermission": "CloudHouse Gold Finance needs the camera to photograph customer KYC documents."
        }
      ],
      "expo-document-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "CloudHouse Gold Finance needs the camera to scan packet label QR codes."
        }
      ]
    ],
    "androidStatusBar": {
      "backgroundColor": "transparent",
      "barStyle": "dark-content",
      "translucent": true
    },
    "extra": {
      "eas": {
        "projectId": "2eefa477-9d29-496f-9e91-06261ed62690"
      }
    }
  }
}
