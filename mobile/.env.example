# Every variable the app reads. Copy to .env.local and fill in; never commit real values.
# Backend API base, e.g. https://api.cloudhousefinance.com/api/v1 (EAS builds set it in eas.json).
EXPO_PUBLIC_API_BASE_URL=
# "true" shows the plan-upgrade flow on the Billing screen (src/common/config/features.ts).
EXPO_PUBLIC_ENABLE_PLAN_UPGRADE=
# JSON array of billing plans; unset falls back to the built-in defaults.
EXPO_PUBLIC_BILLING_PLANS=
