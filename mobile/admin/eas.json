{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://superadmin.cloudhousefinance.com/api/v1"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "development-testflight": {
      "extends": "development",
      "distribution": "store",
      "autoIncrement": true
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "preview-testflight": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "development-testflight": {
      "ios": {
        "appleTeamId": "N7X7Q2H8V8",
        "ascAppId": "6839530879"
      }
    },
    "preview-testflight": {
      "ios": {
        "ascAppId": "6830677656",
        "appleTeamId": "N7X7Q2H8V8"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6830677656",
        "appleTeamId": "N7X7Q2H8V8"
      }
    }
  }
}
