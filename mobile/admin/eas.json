{
  "cli": {
    "version": ">= 24.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://superadmin.cloudhousefinance.com/api/v1"
      }
    },
    "development": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "development": {
      "ios": {
        "ascApiKeyPath": "./certs/AuthKey.p8",
        "ascApiKeyId": "9289TXK48L",
        "ascApiKeyIssuerId": "204e739c-06da-439b-8cc1-bbaa914fcf38",
        "appleTeamId": "N7X7Q2H8V8"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6830677656",
        "ascApiKeyPath": "./certs/AuthKey.p8",
        "ascApiKeyId": "9289TXK48L",
        "ascApiKeyIssuerId": "204e739c-06da-439b-8cc1-bbaa914fcf38",
        "appleTeamId": "N7X7Q2H8V8"
      }
    }
  }
}
