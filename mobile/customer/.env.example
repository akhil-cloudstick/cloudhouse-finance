# Every variable the app reads. Copy to .env.local and fill in; never commit real values.
# Backend customer API base, e.g. http://192.168.1.23:8090/api/v1/customer (falls back to the
# Android emulator alias in src/common/services/httpClient.ts when unset).
EXPO_PUBLIC_API_BASE_URL=
# Tunnel name for 'npm run tunnel' (ngrok). Pick one unique to you, e.g. chf-<app>-<yourname>; the
# Expo Go address is then https://<name>.ngrok.io on whatever port Metro gets.
EXPO_TUNNEL_SUBDOMAIN=
