{
  "expo": {
    "name": "CloudHouse Finance Customer",
    "slug": "cloudhousecustomer",
    "owner": "cloudhouse-production",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cloudhouse.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cloudhouse.customer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cloudhouse.customer",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/cloudhouse-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "scheme": "cloudhousecustomer",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/cloudhouse.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#f7f6fb"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CloudHouse Finance to use Face unlock to sign you in."
        }
      ],
      "expo-web-browser"
    ],
    "androidStatusBar": {
      "backgroundColor": "#f7f6fb",
      "barStyle": "dark-content",
      "translucent": false
    },
    "extra": {
      "eas": {
        "projectId": "e9464d29-8cf4-4537-b7cd-9564a0971fb3"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "expo-status-bar": {
        "style": "dark"
      }
    }
  }
}
