# Backend the dev server proxies /api/v1 and /uploads to (see next.config.ts).
BACKEND_ORIGIN=http://localhost:8080

# The TENANT app's origin — used only to build the sign-in link an operator
# copies for a business (see common/services/tenantLink.ts). Never
# window.location.origin: this console is its own app on its own origin now.
NEXT_PUBLIC_TENANT_APP_ORIGIN=http://localhost:3000

# Only needed if the browser should call the backend directly instead of
# through this app's own dev-server proxy above (e.g. a production build
# served from a static host with no rewrite support of its own).
# NEXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
