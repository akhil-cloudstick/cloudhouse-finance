{
  "expo": {
    "name": "CTFI",
    "slug": "ambikacustomer",
    "owner": "cloudhouse-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ctfi.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.ambikagold.customer",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/ctfi-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "scheme": "ambikacustomer",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/ctfi.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-status-bar",
        {
          "style": "dark",
          "backgroundColor": "#f5f7fb"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Chittilapilly Thommana Financiers & Investments to use Face unlock to sign you in."
        }
      ],
      "expo-web-browser"
    ],
    "androidStatusBar": {
      "backgroundColor": "#f5f7fb",
      "barStyle": "dark-content",
      "translucent": false
    },
    "extra": {
      "eas": {
        "projectId": "1fb4bd03-4939-4a9e-9142-c26294cdedbb"
      }
    }
  }
}
