# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=cloudhouse_gold
DB_PASSWORD=cloudhouse_gold
DB_NAME=cloudhouse_gold
DB_SSLMODE=disable

# Server
PORT=8080
FRONTEND_DIR=../frontend/out
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:3100

# Encryption keys (base64 32-byte: openssl rand -base64 32)
SETTINGS_ENCRYPTION_KEY=
AADHAAR_ENCRYPTION_KEY=

# File uploads folder (default ./uploads)
UPLOADS_DIR=

# Login tokens (JWT_SECRET is required: openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRY=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=

# Surepass KYC and Aadhaar eSign
SUREPASS_API_TOKEN=
SUREPASS_BASE_URL=https://sandbox.surepass.app
SUREPASS_ESIGN_BASE_URL=https://prod-esign-api-v2.surepass.app
SUREPASS_ESIGN_TOKEN=
SUREPASS_ESIGN_SIGN_X=103
SUREPASS_ESIGN_SIGN_Y=478
SUREPASS_ESIGN_Y_FROM_BOTTOM=true
SUREPASS_ESIGN_SLIP_X=103
SUREPASS_ESIGN_SLIP_Y=600
SUREPASS_ESIGN_WITNESS1_X=103
SUREPASS_ESIGN_WITNESS1_Y=338
SUREPASS_ESIGN_WITNESS2_X=396
SUREPASS_ESIGN_WITNESS2_Y=338

# Cashfree (not used yet)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# Razorpay payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp (OpenWA)
WHATSAPP_ORIGIN=http://127.0.0.1:2785
WHATSAPP_API_KEY=
WHATSAPP_SESSION_ID=

# Migrations folder
MIGRATIONS_DIR=./migrations

# Desktop release builds — triggers release.yml on demand and polls its status.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_RELEASE_TOKEN=
GITHUB_RELEASE_WORKFLOW_FILE=release.yml
# Branch/ref release.yml is dispatched against.
GITHUB_RELEASE_REF=Develop_v2

# Same bucket frontend's build scripts use. S3_ACCESS_KEY/S3_SECRET_KEY are the real write credentials (B2's Application Key ID/Key) and live only here, never in frontend/.env.local.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_FOLDER=
S3_ACCESS_KEY=
S3_SECRET_KEY=
