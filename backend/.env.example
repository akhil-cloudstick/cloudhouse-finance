DB_HOST=localhost
DB_PORT=5432
DB_USER=ambikagold
DB_PASSWORD=ambikagold
DB_NAME=ambikagold
DB_SSLMODE=disable
PORT=8080
FRONTEND_DIR=../frontend/out
FRONTEND_ORIGIN=http://localhost:3000
# Encrypts integration API keys stored via the Settings page (see
# internal/settings). Must be a base64-encoded 32-byte key, e.g. generate
# one with: openssl rand -base64 32
# If unset, a fixed dev-only key is used (fine for local dev, NOT for
# production — set a real value before storing real secrets).
SETTINGS_ENCRYPTION_KEY=
# Encrypts each customer's Aadhaar number at rest (see internal/customer).
# Same format as SETTINGS_ENCRYPTION_KEY, but MUST be a separate key —
# generate with: openssl rand -base64 32
# If unset, a fixed dev-only key is used (fine for local dev, NOT for
# production — set a real value before storing real customer data).
AADHAAR_ENCRYPTION_KEY=
# Local-disk folder for uploaded files (customer photos/KYC documents,
# ornament photos), served back under /uploads. Defaults to ./uploads.
UPLOADS_DIR=
# Signs/verifies login JWTs (see internal/auth). Set a long random secret —
# generate one with: openssl rand -base64 32
# If unset, a fixed dev-only secret is used (fine for local dev, NOT for
# production).
JWT_SECRET=
# How long an issued login token stays valid. Accepts a normal Go duration
# (e.g. "168h") or "<n>d" (e.g. "3d", "7d"). Defaults to 168h (7 days) if
# unset/unparseable.
JWT_EXPIRY=
# SMTP settings for outgoing password-reset emails (see platform/mailer.go).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Twilio credentials for outgoing SMS/WhatsApp customer notifications (see
# internal/notification). ACCOUNT_SID is always required (identifies the
# account). Authenticate with EITHER the account Auth Token OR a scoped API
# Key SID/Secret pair (recommended — revocable without rotating the whole
# account's Auth Token). FROM_NUMBER must be a Twilio-provisioned number
# (E.164 format, e.g. +15551234567).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
# Setu Data Gateway credentials for PAN verification (see
# internal/platform/setu.go, https://docs.setu.co/data). Get these from the
# Setu dashboard's PAN Verification product instance.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# https://dg-sandbox.setu.co for testing, https://dg.setu.co for production.
# Defaults to the sandbox host if unset.
SETU_BASE_URL=https://dg-sandbox.setu.co
# Setu DigiLocker credentials for Aadhaar verification (see
# internal/platform/setu_digilocker.go, https://docs.setu.co/data/digilocker).
# A separate Setu product instance from PAN verification above, so its own
# client-id/secret/product-instance-id.
SETU_DIGILOCKER_CLIENT_ID=
SETU_DIGILOCKER_CLIENT_SECRET=
SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=
SETU_DIGILOCKER_BASE_URL=https://dg-sandbox.setu.co
# Setu Aadhaar eSign product ("gold loan - Aadhaar eSign" on the Setu
# dashboard). Same org client-id/secret as PAN/DigiLocker above — only the
# product instance id is unique to this product. Digitally signs the loan
# indemnity bond (see internal/platform/setu_esign.go,
# internal/loan/indemnitybond.go, and Service.StartIndemnityBondSign/
# CheckIndemnityBondSign) — requires Chrome/Chromium on this host (see
# README's "Indemnity bond eSign" setup note for why and how).
SETU_ESIGN_CLIENT_ID=
SETU_ESIGN_CLIENT_SECRET=
SETU_ESIGN_PRODUCT_INSTANCE_ID=
SETU_ESIGN_BASE_URL=https://dg-sandbox.setu.co
# Cashfree Secure ID credentials — sandbox test keys for now (Aadhaar OTP
# verification: offline-aadhaar/otp + offline-aadhaar/verify). Not yet
# wired into any code — added to .env only, per explicit instruction not to
# use/test until confirmed.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
